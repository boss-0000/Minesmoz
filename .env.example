# --- Database -------------------------------------------------------------
# Pooled connection, used by the application. Neon requires sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection, used only by migrations. On Neon this is the
# same host without "-pooler". Locally it can be the same value as DATABASE_URL.
# Prisma needs this because Neon's pooler runs in transaction mode and cannot
# hold the advisory locks that `prisma migrate deploy` requires.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Private document storage --------------------------------------------
# Leave S3_BUCKET empty to use the local-filesystem driver. That driver is for
# development only and refuses to run when NODE_ENV=production, because
# serverless filesystems are ephemeral and would lose uploaded documents.
# When set, uploads go to S3 and downloads are served as 5-minute signed URLs.
S3_BUCKET=""
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional. Set for S3-compatible services such as Cloudflare R2, e.g.
# https://<accountid>.r2.cloudflarestorage.com — leave empty for real AWS S3.
S3_ENDPOINT=""

# --- One-off seeding ------------------------------------------------------
# When set to "1", the deployment build seeds the database after migrating.
# This DELETES existing demo data. Set it, deploy once, then remove it.
RUN_SEED=""
